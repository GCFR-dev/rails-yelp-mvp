<div class="bg-white rounded-4 shadow-sm p-5 mx-auto" style="max-width: 600px;">
  <h1 class="fw-bold mb-4">Ton avis sur <%= @restaurant.name %></h1>

  <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :rating %>
    <%= f.input :content %>
    <%= f.button :submit, class: "btn btn-warning rounded-pill px-4 mt-2" %>
  <% end %>

  <%= link_to "← Retour au restaurant", restaurant_path(@restaurant), class: "btn btn-link text-dark px-0 mt-3" %>
</div>
